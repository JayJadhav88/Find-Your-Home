# Edge Function secrets. Locally: copy to supabase/functions/.env (git-ignored).
# Hosted: `supabase secrets set NAME=value` (never commit real values).

# Shared secret the scheduler sends as x-worker-secret. At least 32 random characters.
WORKER_SECRET=
# log (prints emails; local development) | resend (production)
EMAIL_PROVIDER=log
# Required when EMAIL_PROVIDER=resend. Create the key at resend.com with "sending access" only.
RESEND_API_KEY=
# Verified sender, e.g. "Find Your Home <notifications@your-domain.com>"
EMAIL_FROM=
# Public website URL used for links in emails.
SITE_URL=http://localhost:3000
