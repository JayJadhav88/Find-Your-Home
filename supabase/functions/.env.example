# Edge Function secrets. Locally: copy to supabase/functions/.env (git-ignored).
# Hosted: `supabase secrets set NAME=value` (never commit real values).

# Shared secret the scheduler sends as x-worker-secret. At least 32 random characters.
WORKER_SECRET=
# log (prints emails; local development) | resend (production)
EMAIL_PROVIDER=log
# Required when EMAIL_PROVIDER=resend. Create the key at resend.com with "sending access" only.
RESEND_API_KEY=
# Verified sender, e.g. "Find Your Home <notifications@your-domain.com>"
EMAIL_FROM=
# Public website URL used for links in emails.
SITE_URL=http://localhost:3000
# Optional: website cache refresh after photos are published/removed (see apps/web /api/revalidate).
# Locally the Edge Runtime runs in Docker, so reach the Next.js server via host.docker.internal.
REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate
# Same value as REVALIDATE_SECRET in apps/web/.env.local. At least 32 random characters.
REVALIDATE_SECRET=
# LOCAL DEVELOPMENT ONLY - never set these in production.
# Lets the spreadsheet image importer fetch test images from the local web server.
# ALLOW_HTTP_IMAGE_IMPORT=true
# IMPORT_ALLOWED_PRIVATE_HOSTS=host.docker.internal
# Browser notifications (Web Push). Generate with `pnpm setup:web-push` (local) or
# `pnpm setup:web-push --print` (hosted). The public key also goes to the website as
# NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY. Keep the same pair once people have subscribed.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Optional contact for push services; defaults to the site contact email.
# WEB_PUSH_SUBJECT=mailto:ops@your-domain.com
# Optional fallbacks when not saved in Admin -> Integrations.
# EXPO_ACCESS_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v23.0
# LOCAL DEVELOPMENT: print push and WhatsApp messages instead of sending them.
# NOTIFY_LOG_ONLY=true
