{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_IOS_BUNDLE_ID": "com.findyourhome.app.preview",
        "APP_ANDROID_PACKAGE": "com.findyourhome.app.preview",
        "APP_NAME": "Find Your Home (preview)"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_IOS_BUNDLE_ID": "com.example.findyourhome",
        "APP_ANDROID_PACKAGE": "com.example.findyourhome"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
