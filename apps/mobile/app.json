{
  "expo": {
    "name": "Find Your Home",
    "slug": "find-your-home",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "findyourhome",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0B3266"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find Your Home uses your location only when you tap Near me, to show homes close to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Find Your Home uses your photo library so you can add pictures of a property you are listing.",
          "cameraPermission": "Find Your Home uses the camera so you can take pictures of a property you are listing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2cd57faf-a3e5-47aa-bfa3-695e62fb6fb3"
      }
    },
    "owner": "jaydeep88s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2cd57faf-a3e5-47aa-bfa3-695e62fb6fb3"
    }
  }
}
