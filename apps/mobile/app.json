{
  "expo": {
    "name": "Find Your Home",
    "slug": "find-your-home",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "findyourhome",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5F57",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-image",
      "expo-web-browser",
      ["expo-notifications", { "color": "#1F5F57" }],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Find Your Home uses your location only when you tap Near me, to show homes close to you." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Find Your Home uses your photo library so you can add pictures of a property you are listing.",
          "cameraPermission": "Find Your Home uses the camera so you can take pictures of a property you are listing.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
