{
  "name": "find-your-home",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:hostinger": "node scripts/build-hostinger.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "workers": "node scripts/run-workers.mjs",
    "setup:web-push": "node scripts/setup-web-push.mjs",
    "test:functions": "vitest run supabase/functions",
    "sync:functions": "node scripts/sync-functions-shared.mjs",
    "smoke": "node scripts/local-smoke-test.mjs",
    "e2e": "pnpm --filter @fyh/web e2e"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "supabase": "^2.121.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
