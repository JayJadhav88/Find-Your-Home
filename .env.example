# Find Your Home — environment variables.
# Copy to apps/web/.env.local and apps/mobile/.env.local and fill in values.
# Never commit real values. Never put a SECRET / service-role key in a NEXT_PUBLIC_ or EXPO_PUBLIC_ variable;
# the shared config validator refuses to start if you do.

# ---------- Web (apps/web/.env.local) ----------
# Supabase API URL. Local: printed by `npx supabase start` (usually http://127.0.0.1:44321).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. Safe for browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public base URL of the website, used for canonical URLs, sitemaps and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public key for browser notifications (pnpm setup:web-push). Leave empty to hide the option.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# Show "Continue with Google" once the Google provider is set up in Supabase Auth.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
EXPO_PUBLIC_GOOGLE_SIGN_IN=false
# Supabase secret (service-role) key. SERVER ONLY and currently unused by the website; leave empty unless a server feature needs it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Shared secret for POST /api/revalidate, called by the photo worker. SERVER ONLY, 32+ random characters.
# Must match REVALIDATE_SECRET in the Edge Function secrets.
REVALIDATE_SECRET=

# ---------- Mobile (apps/mobile/.env.local) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Website base URL, used to build share links to listings.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin bootstrap script (shell environment only, never a file in the repo) ----------
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
